@@ -0,0 +1,57 @@
+"""W3C trace-context propagation (OTel-optional) for Frappe RQ background jobs..."""
+
+import os
+from typing import Any
+
+_DISABLE = "FRAPPE_DISABLE_OTEL"
+
+
+def is_available() -> bool:
+    if os.environ.get(_DISABLE, "0") == "1":
+        return False
+    try:
+        import opentelemetry  # noqa: F401
+        return True
+    except Exception:
+        return False
+
+
+def get_trace_context() -> dict:
+    if not is_available():
+        return {}
+    try:
+        from opentelemetry import trace
+        from opentelemetry.trace.propagation.tracecontext import TraceContextTextMapPropagator
+
+        if not trace.get_current_span().is_recording():
+            return {}
+
+        carrier = {}
+        TraceContextTextMapPropagator().inject(carrier=carrier)
+        return carrier
+    except Exception:
+        return {}
+
+
+def attach_trace_context(carrier) -> Any:
+    if not carrier or not is_available():
+        return None
+    try:
+        from opentelemetry.context import attach, get_current
+        from opentelemetry.trace.propagation.tracecontext import TraceContextTextMapPropagator
+
+
+        ctx = TraceContextTextMapPropagator().extract(carrier=carrier, context=get_current())
+        return attach(ctx)
+    except Exception:
+        return None
+
+
+def detach_trace_context(token) -> None:
+    if not token:
+        return
+    try:
+        from opentelemetry.context import detach
+        detach(token)
+    except Exception:
+        return
