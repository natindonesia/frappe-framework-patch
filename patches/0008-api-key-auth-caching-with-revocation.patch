diff --git a/frappe/cache_manager.py b/frappe/cache_manager.py
index fc4cb7e0d1..db991498f4 100644
--- a/frappe/cache_manager.py
+++ b/frappe/cache_manager.py
@@ -88,11 +88,24 @@ def clear_user_cache(user=None):
 	if user:
 		frappe.cache.hdel_names(user_cache_keys, user)
 		frappe.cache.delete_keys("user:" + user)
+		# Invalidate cached API key authentication credentials for this user
+		try:
+			api_key = frappe.cache.get_value(f"user_api_key:{user}")
+			if api_key:
+				frappe.cache.delete_value(f"api_auth_cache:{api_key}")
+				frappe.cache.delete_value(f"user_api_key:{user}")
+		except Exception:
+			pass
 		clear_defaults_cache(user)
 	else:
 		frappe.cache.delete_key(user_cache_keys)
 		clear_defaults_cache()
 		clear_global_cache()
+		try:
+			frappe.cache.delete_keys("api_auth_cache:*")
+			frappe.cache.delete_keys("user_api_key:*")
+		except Exception:
+			pass
 
 
