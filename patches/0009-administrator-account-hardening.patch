+def get_administrator_password_issues(password: str) -> list[str]:
+	"""Return reasons why `password` is not acceptable for the Administrator account."""
+	from frappe.utils.password_strength import test_password_strength
+
+	result = test_password_strength(password)
+	score = result.get("score", 0)
+	issues = []
+
+	if score < MINIMUM_ADMINISTRATOR_PASSWORD_SCORE:
+		issues.append(_("Password is too guessable. Use a longer, less common password."))
+
+	# Only apply the common-password rule while the password is still weak. A
+	# strong password may legitimately contain a common word (e.g. "admin") as
+	# one part of a longer passphrase.
+	is_common_password = score <= MINIMUM_ADMINISTRATOR_PASSWORD_SCORE and any(
+		match.get("dictionary_name") == "passwords" for match in result.get("sequence") or []
+	)
+	if is_common_password:
+		issues.append(_("Password is a commonly used password."))
+
+	return issues
+
+
+def validate_administrator_password(password: str) -> None:
+	if issues := get_administrator_password_issues(password):
+		frappe.throw(
+			msg="<br>".join(issues),
+			title=_("Weak Administrator password"),
+		)
+
+
