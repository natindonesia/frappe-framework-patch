+_WORKER_CONNECTION_CACHE = {}  # site -> db_instance
+
+
+def _get_worker_db(site: str):
+	"""Reuse persistent DB connection for workers when running in no-fork mode."""
+	if not os.environ.get("FRAPPE_BACKGROUND_WORKERS_NOFORK"):
+		frappe.init(site, force=True, is_job=True)
+		frappe.connect()
+		return
+
+	cached_db = _WORKER_CONNECTION_CACHE.get(site)
+	if cached_db is not None:
+		try:
+			if hasattr(cached_db, "_conn") and cached_db._conn:
+				cached_db._conn.ping(reconnect=True)
+				frappe.init(site, force=True, is_job=True)
+				frappe.local.db = cached_db
+				return
+		except Exception:
+			try:
+				cached_db.close()
+			except Exception:
+				pass
+			_WORKER_CONNECTION_CACHE.pop(site, None)
+
+	# Close any other cached connections if switching sites to avoid connection bloat
+	for other_site, other_db in list(_WORKER_CONNECTION_CACHE.items()):
+		if other_site != site:
+			try:
+				other_db.close()
+			except Exception:
+				pass
+			_WORKER_CONNECTION_CACHE.pop(other_site, None)
+
+	frappe.init(site, force=True, is_job=True)
+	frappe.connect()
+	_WORKER_CONNECTION_CACHE[site] = frappe.local.db
+
+
+def _teardown_worker_job(site: str):
+	"""Teardown worker job: reset transaction, flush locals, and preserve DB if in nofork mode."""
+	if not os.environ.get("FRAPPE_BACKGROUND_WORKERS_NOFORK"):
+		frappe.destroy()
+		return
+
+	db = getattr(frappe.local, "db", None)
+	if db is not None:
+		try:
+			db.rollback()
+			_WORKER_CONNECTION_CACHE[site] = db
+		except Exception:
+			try:
+				db.close()
+			except Exception:
+				pass
+			_WORKER_CONNECTION_CACHE.pop(site, None)
+
+	frappe.release_local(frappe.local)
+
+
