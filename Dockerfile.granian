# syntax=docker/dockerfile:1.4
# =============================================================================
# Granian alternative runtime — OPTIONAL, opt-in CI build. NOT the default.
#
# Extends the canonical `frappe` image (Dockerfile) and additionally installs
# the Granian Rust WSGI/ASGI server into the bench venv, so the `web` service
# can serve the app via Granian instead of gunicorn:
#
#   env/bin/granian --interface wsgi --host 0.0.0.0 --port 8000 \
#     --workers 2 --blocking-threads 4 frappe.otel_wsgi:application
#
# The app entrypoint (frappe.otel_wsgi:application) is unchanged and shared
# with gunicorn — it only wraps the app with OpenTelemetry when the
# OTEL_EXPORTER_OTLP_ENDPOINT env is set. So the runtime swap is confined to
# the server process; nothing in frappe/ differs.
#
# BASE IMAGE is parameterised via ARG BASE_IMAGE:
#   - default `frappe:latest` (local dev build that has produced frappe:latest).
#   - CI passes `--build-arg BASE_IMAGE=frappe:latest` in the same-job build so
#     Granian layers directly on the exact vanilla image result of the same run
#     (no registry pull, no second source build).
# The tested local `frappe-granian:latest` result is what CI tags and pushes;
# no registry pull and no second source build is involved.
# This image is only ever published as `<registry>/frappe:latest-granian`.
# =============================================================================
ARG BASE_IMAGE=frappe:latest
FROM ${BASE_IMAGE} AS granian

ARG IMAGE_VERSION
ARG IMAGE_REVISION
ARG IMAGE_SOURCE=https://github.com/natindonesia/frappe-framework-patch
ARG IMAGE_CREATED
ARG FRAPPE_SHA
LABEL org.opencontainers.image.title="Frappe Framework backend (Granian runtime)" \
      org.opencontainers.image.description="Patched Frappe/ERPNext served by the Granian WSGI/ASGI server instead of gunicorn." \
      org.opencontainers.image.url="https://github.com/natindonesia/frappe-framework-patch" \
      org.opencontainers.image.source="${IMAGE_SOURCE}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.created="${IMAGE_CREATED}" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.frappe-sha="${FRAPPE_SHA}" \
      org.opencontainers.image.variant=latest-granian \
      org.opencontainers.image.patches-applied=true

USER frappe

# Install Granian into the bench venv that bench init created.
RUN /home/frappe/frappe-bench/env/bin/pip install \
      --no-cache-dir \
      granian \
    && mkdir -p /home/frappe/frappe-bench/logs /home/frappe/logs \
    && chown frappe:frappe /home/frappe/frappe-bench/logs /home/frappe/logs