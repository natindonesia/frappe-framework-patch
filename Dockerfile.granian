# syntax=docker/dockerfile:1
# =============================================================================
# Granian alternative runtime variant.
#
# OPTIONAL alternative runtime, kept OUT of the root Dockerfile so the default
# (wheel + OTel base image) pipeline is untouched. This image is a THIN LAYER
# on the canonical patched-Frappe base image (built from the root Dockerfile as
# `frappe:latest` earlier in the same CI job) and additionally installs the
# Granian Rust WSGI/ASGI server into the same Python environment:
#
#   granian --interface wsgi --host 0.0.0.0 --port 8000 \
#     --workers 2 --blocking-threads 4 frappe.app:application
#
# The WSGI application is unchanged (`frappe.app:application`, with OTel wrap
# when OTEL_EXPORTER_OTLP_ENDPOINT is set). Only the server process differs;
# nothing in frappe/ changes.
#
# BASE IMAGE: `frappe:latest` MUST already exist locally (built by the root
# Dockerfile in the same CI job). This image is CI-only by default; it is
# published separately with the same immutable-tag convention as the base.
# =============================================================================
FROM frappe:latest AS granian

ARG UPSTREAM_SHA=unknown
ARG PATCH_REPO_SHA=unknown

# Install Granian into the same Python env that pip created for the framework
# (the base image installs the patched frappe wheel into site-packages).
RUN pip install --no-cache-dir granian

LABEL org.opencontainers.image.title="frappe-framework-patch (granian)"
LABEL org.opencontainers.image.description="Patched Frappe framework base image with Granian server (version-16)"
LABEL org.opencontainers.image.source="https://github.com/natindonesia/frappe-framework-patch"
LABEL org.opencontainers.image.revision="${PATCH_REPO_SHA}"
LABEL org.natindonesia.frappe.upstream-sha="${UPSTREAM_SHA}"
LABEL org.natindonesia.frappe.patch-sha="${PATCH_REPO_SHA}"
LABEL org.natindonesia.frappe.variant="granian"