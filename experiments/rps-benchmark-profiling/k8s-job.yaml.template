apiVersion: batch/v1
kind: Job
metadata:
  name: frappe-benchmark-job
  namespace: default
  labels:
    app.kubernetes.io/name: frappe-benchmark
    app.kubernetes.io/part-of: frappe-bench
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 300
  template:
    metadata:
      labels:
        app.kubernetes.io/name: frappe-benchmark
    spec:
      restartPolicy: Never
      containers:
        - name: k6-runner
          image: grafana/k6:latest
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
            - |
              echo "[*] Launching k6 benchmark in k8s pod with Scenario=${SCENARIO:-custom}..."
              k6 run /scripts/k6-workload.js \
                --summary-export=/tmp/summary.json
              echo "===K6_SUMMARY_START==="
              cat /tmp/summary.json
              echo "===K6_SUMMARY_END==="
          env:
            - name: TARGET_URL
              value: "${TARGET_URL}"
            - name: API_KEY
              value: "${API_KEY}"
            - name: API_SECRET
              value: "${API_SECRET}"
            - name: USER_EMAIL
              value: "${USER_EMAIL}"
            - name: USER_PASSWORD
              value: "${USER_PASSWORD}"
            - name: ENABLE_LOGIN
              value: "${ENABLE_LOGIN}"
            - name: WORKLOAD_TYPE
              value: "${WORKLOAD_TYPE}"
            - name: SCENARIO
              value: "${SCENARIO}"
            - name: VUS
              value: "${TEST_VUS}"
            - name: DURATION
              value: "${TEST_DURATION}"
          volumeMounts:
            - name: test-scripts
              mountPath: /scripts
          resources:
            requests:
              cpu: 200m
              memory: 256Mi
            limits:
              cpu: 2000m
              memory: 1Gi
      volumes:
        - name: test-scripts
          configMap:
            name: frappe-benchmark-config
